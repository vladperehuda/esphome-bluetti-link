# Copy to secrets.yaml and fill in.
wifi_ssid: "my-wifi"
wifi_password: "change-me"

# Bluetti station BLE MAC (find it once from the ESPHome log, or a BLE scanner app).
bluetti__bluetti_mac: "AA:BB:CC:DD:EE:FF"

# Native API encryption key: 32 bytes, base64. Generate with `openssl rand -base64 32`.
# Also encrypts OTA uploads.
bluetti__api_key: "change-me"
